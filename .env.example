# Hugging Face Token for downloading base models (e.g., FLUX.1-dev)
HF_TOKEN=hf_your_token_here

# AWS Configuration (for SageMaker & S3)
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your_aws_account_id
SAGEMAKER_BUCKET=sagemaker-us-east-1-your_aws_account_id
SAGEMAKER_ROLE_ARN=arn:aws:iam::your_aws_account_id:role/your_sagemaker_role

# Modal / Server
API_TOKEN=your_custom_secret_token
